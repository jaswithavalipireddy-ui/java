public class MoveZeroes {
 public static void main(String[] args) {
 int[] nums = {0, 1, 0, 3, 12};
 int position = 0;
 for (int i = 0; i < nums.length; i++) {
 if (nums[i] != 0) {
 nums[position] = nums[i];
 position++;
 }
 }
 while (position < nums.length) {
 nums[position] = 0;
 position++;
 }
 System.out.print("Output: ");
 for (int num : nums) {
 System.out.print(num + " ");
 }
 }
}
